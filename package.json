{
  "name": "health-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/server/index.js",
    "test": "vitest run",
    "e2e": "playwright test --trace off",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "setup": "tsx scripts/setup.ts",
    "seed:dev": "tsx scripts/seed-dev.ts",
    "install-service": "tsx scripts/install-service.ts install",
    "uninstall-service": "tsx scripts/install-service.ts uninstall"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@tanstack/react-query": "^5.108.4",
    "better-sqlite3": "^13.2.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "maplibre-gl": "^6.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.7",
    "stream-json": "^3.9.0",
    "uplot": "^1.6.32",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.9",
    "@types/react": "^18.3.32",
    "@types/react-dom": "^18.3.7",
    "@types/stream-json": "^1.7.8",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^31.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
